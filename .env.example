# Required: OpenRouter API key for LLM chat functionality
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Optional: Massive (Polygon.io) API key for real market data
# If not set, the built-in market simulator is used (recommended for most users)
MASSIVE_API_KEY=

# Optional: Set to "true" for deterministic mock LLM responses (testing)
LLM_MOCK=false

# --- Optional market data tuning (defaults shown) ---
# Seconds between Massive polls (minimum 2). Free tier: 15. Paid tiers: 2-5.
# MASSIVE_POLL_INTERVAL=15
# Simulator tick interval in seconds (minimum 0.05; volatility per second is unchanged)
# SIMULATOR_INTERVAL=0.5
# Per-ticker, per-tick probability of a sudden 2-5% move (clamped to 0-1)
# SIMULATOR_EVENT_PROBABILITY=0.001
# Integer seed for deterministic simulated prices (useful for E2E tests)
# SIMULATOR_SEED=
